+// SPDX-License-Identifier: MIT
+package cmd
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"net/http"
+	"regexp"
+	"time"
+
+	"github.com/larksuite/cli/internal/client"
+	"github.com/larksuite/cli/internal/cmdutil"
+	"github.com/larksuite/cli/internal/core"
+	"github.com/larksuite/cli/internal/credential"
+	"github.com/spf13/cobra"
+)
+
+var cardMessageID = regexp.MustCompile("^om_[a-zA-Z0-9_-]+$")
+
+func newAutoloopCards(f *cmdutil.Factory) *cobra.Command {
+	return &cobra.Command{
+		Use:   "autoloop-card-patches",
+		Short: "Update Feishu cards over a single authenticated client",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			api, err := f.NewAPIClient()
+			if err != nil {
+				return err
+			}
+			ctx, cancel := context.WithTimeout(cmd.Context(), 15*time.Second)
+			_, _ = api.Credential.ResolveToken(ctx, credential.NewTokenSpec(core.AsBot, api.Config.AppID))
+			cancel()
+			in := bufio.NewScanner(f.IOStreams.In)
+			in.Buffer(make([]byte, 4096), 128*1024)
+			out := json.NewEncoder(f.IOStreams.Out)
+			for in.Scan() {
+				var req struct {
+					Ref     string `json:"ref"`
+					Content string `json:"content"`
+				}
+				result := map[string]bool{"ok": false}
+				if json.Unmarshal(in.Bytes(), &req) == nil && cardMessageID.MatchString(req.Ref) && len(req.Content) <= 30*1024 && json.Valid([]byte(req.Content)) {
+					ctx, cancel := context.WithTimeout(cmd.Context(), 15*time.Second)
+					response, err := api.CallAPI(ctx, client.RawApiRequest{
+						Method: http.MethodPatch, URL: "/open-apis/im/v1/messages/" + req.Ref,
+						Data: map[string]string{"content": req.Content}, As: core.AsBot,
+					})
+					cancel()
+					result["ok"] = err == nil && api.CheckResponse(response, core.AsBot) == nil
+				}
+				if err := out.Encode(result); err != nil {
+					return err
+				}
+			}
+			return in.Err()
+		},
+	}
+}
