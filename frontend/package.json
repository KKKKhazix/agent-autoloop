{
  "name": "agent-autoloop-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "fixture": "node tests/fixture.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json,html}\" \"tests/*.ts\""
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "@vue-flow/core": "^1.48.2",
    "eventsource-parser": "^4.1.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
